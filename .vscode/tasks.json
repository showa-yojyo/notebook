{
    "version": "2.0.0",
    "tasks": [
        {
            "command": "uv run make -C ${workspaceFolder}/doc html",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "label": "(uv) Build HTML files",
            "problemMatcher": [],
            "type": "shell"
        },
        {
            "command": "open",
            "group": "test",
            "args": [
                {
                    "value": "${workspaceFolder}/doc/build/html/index.html",
                    "quoting": "weak"
                }
            ],
            "label": "View HTML files",
            "problemMatcher": [],
            "type": "shell"
        }
    ]
}
